#!/usr/bin/env bash
# ============================================================
#  deckkit / patches —— 用户配置
#
#  给 Steam 游戏打"文件包"式补丁（汉化/破解/素材包）：把补丁解包后的文件
#  挂载进游戏目录，并支持一键卸载 / Steam 校验完整性后重新挂载。
#
#  Mac 侧只负责：解包 + 上传 + 校验目标；挂载动作全部在 Deck 上完成。
#  改这里不需要动 service 脚本。
# ============================================================

# ---------- Deck 连接 ----------
DECK_SSH="deck"                    # ~/.ssh/config 里的别名（强 AddressFamily inet）
DECK_HOST="steamdeck.local"        # mDNS 名字，只用于显示 / 报错提示
DECK_HOME="/home/deck"             # Deck 上的家目录（远端 ~ 不展开的地方就靠它拼绝对路径）

# ---------- Deck 侧布局 ----------
# 补丁库：store/<appid>/<补丁名>/{manifest.tsv,resolved.tsv,meta.tsv}
#   （patch.exe / payload 只在入库→挂载这段时间在 Deck 上，挂完立刻删）
DECK_PATCH_ROOT="~/deckkit/services/patches"

# ---------- 解包 ----------
# 补丁 exe 常见的三种「文件包」形态，按顺序探测（见 mac/patch-extract.py）：
#   Setup Factory  → 需要 sfextract（pip3 install --user sfextract）
#   Inno Setup     → 需要 innoextract（brew install innoextract）
#   7z / NSIS SFX  → 需要 7zz（brew install sevenzip），一般都有
# 都不可用时 add 会明确告诉你要装哪个。

# ---------- Deck 上留什么 ----------
# 安装包和解包结果**都不留在 Deck**（安装包你自己保存；要重挂时再选一次那个 exe，
# 服务会临时解包+传输，挂完立刻删）。Deck 上只留两样小东西：
#   manifest.tsv  文件清单 + md5（几 KB，用来算「挂没挂上」的状态）
#   resolved.tsv  路径大小写/分隔符纠正表（补丁是 Windows 语义，Deck 敏感）
# 想改成留缓存（重挂不用再选 exe、不用再传）就把下面两项设成 yes。
KEEP_INSTALLER_ON_DECK="no"
KEEP_PAYLOAD_ON_DECK="no"

# ---------- 其它 ----------
SSH_TIMEOUT=10
