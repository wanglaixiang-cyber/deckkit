#!/usr/bin/env bash
# ============================================================
#  deckkit —— Steam Deck 服务框架的统一入口
#
#    deck                    概览：有哪些服务、各自什么状态
#    deck list               列出服务
#    deck status [服务]      查看状态
#    deck <服务> <子命令>     转发给 services/<服务>/service
#    deck ssh [命令]         SSH 到 Deck（默认 steamdeck.local）
#    deck root <命令>        以 root 在 Deck 上执行（需要免密 sudo 已授权）
#    deck push <本地> <远端>  传文件到 Deck
#    deck menu [--run|--install|--dev]  编译菜单栏 App（--install 装到 /Applications）
#    deck brief             精简状态：一个服务一行（完整：deck status）
#    deck vitals [--json]    读 Deck 电量 / 充电状态 / 温度 / 运行时长
#    deck self-install       把 deck 放进 PATH（之后任意目录直接敲 deck）
#    deck ensure [服务]      让服务自愈（幂等）：files 没挂上就挂上
#    deck toggle <服务>      切换服务主状态：files 挂载 / 卸载
#    deck doctor             环境体检
#
#  加新服务：在 services/<名字>/ 建一个可执行的 service 入口，
#  在这个框架里就自动出现在 `deck list` 和 `deck status` 里。
# ============================================================
set -uo pipefail

# 解析软链：~/bin/deck 是软链时，dirname 会落到 ~/bin，根目录就找错了。
# 一路 readlink 到真实文件，再从它所在目录往上找。
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
  _dir="$(cd -P "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  case "$_self" in /*) ;; *) _self="${_dir}/${_self}" ;; esac
done
ROOT="$(cd -P "$(dirname "$_self")/.." && pwd)"
SERVICES_DIR="${ROOT}/services"

# Deck 连接参数（可用环境变量覆盖）
DECK_HOST="${DECKKIT_DECK_HOST:-steamdeck.local}"
DECK_SSH="${DECKKIT_DECK_SSH:-deck}"          # ~/.ssh/config 里的别名

# SSH 连接复用。一次刷新要开 6~8 个 SSH 连接（vitals + 每个服务 status 内部
# 还有好几次），每次重新握手约 0.2 秒，累积起来就是菜单栏「更新慢半拍」的主因。
# 实测：连续 3 次调用 0.56s → 0.07s。
SSH_MUX=(-o ControlMaster=auto -o ControlPath="$HOME/.ssh/deckkit-cm-%r@%h:%p" -o ControlPersist=15s)

if [ -t 1 ]; then
  B=$'\033[1;36m'; G=$'\033[1;32m'; Y=$'\033[1;33m'; R=$'\033[1;31m'; D=$'\033[2m'; N=$'\033[0m'
else
  B=; G=; Y=; R=; D=; N=
fi
say()  { printf '%s\n' "$*"; }
hdr()  { printf '\n%s%s%s\n' "$B" "$*" "$N"; }
ok()   { printf '%s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$N" "$*"; }
die()  { printf '%s✗%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

services() {
  local d
  for d in "$SERVICES_DIR"/*/; do
    [ -d "$d" ] || continue
    basename "$d"
  done
}

svc_desc() {
  local f="$SERVICES_DIR/$1/SERVICE.md"
  if [ -f "$f" ]; then
    sed -n '1s/^#*[[:space:]]*//p' "$f"
  else
    echo "(无说明)"
  fi
}

svc_entry() { printf '%s/%s/service' "$SERVICES_DIR" "$1"; }

usage() { sed -n '2,20p' "$0" | sed 's/^# \?//'; }

# 把 deck 放到 PATH 上（软链到 ~/.local/bin 或 /usr/local/bin，必要时写 ~/.zshrc）
cmd_self_install() {
  local src; src="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/deck"
  local target="" d
  for d in /usr/local/bin "$HOME/.local/bin" "$HOME/bin"; do
    [ -d "$d" ] && [ -w "$d" ] && { target="$d"; break; }
  done
  [ -n "$target" ] || { mkdir -p "$HOME/.local/bin" && target="$HOME/.local/bin"; }
  ln -sf "$src" "$target/deck" || die "创建软链失败：$target"
  printf '  \033[32m✓\033[0m 已链接 %s/deck → %s\n' "$target" "$src"
  case ":$PATH:" in
    *":$target:"*) printf '  %s 已经在 PATH 里，任意目录直接敲 deck 就行\n' "$target" ;;
    *)
      local z="$HOME/.zshrc"
      [ -f "$z" ] || : > "$z"
      if grep -q "deckkit PATH" "$z" 2>/dev/null; then
        printf '  ~/.zshrc 里已经加过 PATH\n'
      else
        printf '\n# deckkit PATH\nexport PATH="%s:$PATH"\n' "$target" >> "$z"
        printf '  \033[32m✓\033[0m 已把 %s 写进 ~/.zshrc（新开终端生效）\n' "$target"
      fi
      ;;
  esac
  printf '  验证：deck games list\n' 
}

# 每个服务最常用的命令（服务自己的 help 优先，没有就从用法注释里挑"deck xxx"那几行）
cmd_cmds() {
  local root; root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  local d name desc body
  for d in "$root"/services/*/; do
    name="$(basename "$d")"; [ -f "$d/service" ] || continue
    desc=""; [ -f "$d/SERVICE.md" ] && desc="$(sed -n '1s/^# *//p' "$d/SERVICE.md")"
    printf '\n  \033[1m%s\033[0m' "$name"
    [ -n "$desc" ] && printf '  \033[2m%s\033[0m' "$desc"
    printf '\n'
    body="$( "$d/service" help 2>/dev/null || true )"
    [ -n "$body" ] || body="$(sed -n '2,30p' "$d/service" | sed -n 's/^# *//p')"
    # 统一只留命令行（各服务的 help/用法注释脏瘦不一，这里过滤 + 限制条数，
    # 保证每段都整齐；详细说明让用户跑 deck <服务> help）
    printf '%s\n' "$body" | sed 's/^[[:space:]]*#[[:space:]]*//' \
      | grep -E '^[[:space:]]*deck ' | head -6 \
      | sed 's/^[[:space:]]*/    /'
  done
  printf '\n  \033[2m完整用法：deck help --all     单个服务：deck <服务> help-all\033[0m\n\n'
}

# ---------------- 内建子命令 ----------------
cmd_list() {
  local s
  hdr "deckkit 服务"
  for s in $(services); do
    printf '  %-12s %s\n' "$s" "$(svc_desc "$s")"
  done
  echo
  printf '%s  根目录：%s%s\n' "$D" "$ROOT" "$N"
}

# 精简状态：一行一个服务（终端里的游戏管理页顶部用的就是它，也是"不想看全量"时的一条命令）。
# 想好看全量：deck status
cmd_brief() {
  local s e out
  for s in $(services); do
    e="$(svc_entry "$s")"
    if [ -x "$e" ]; then
      out="$("$e" status 2>/dev/null | sed -n '/[^[:space:]]/{s/^[[:space:]]*//;p;q;}')"
      printf '  %s%-10s%s %s\n' "$B" "$s" "$N" "${out:-—}"
    else
      printf '  %s%-10s%s %s(没有 service 入口)%s\n' "$B" "$s" "$N" "$D" "$N"
    fi
  done
  printf '  %s完整状态：deck status · 服务清单：deck list%s\n' "$D" "$N"
}

cmd_overview() {
  local s
  hdr "deckkit"
  printf '  根目录    %s\n' "$ROOT"
  printf '  Deck      %s  (%s)\n' "$DECK_HOST" "$DECK_SSH"
  if ssh "${SSH_MUX[@]}" -o BatchMode=yes -o ConnectTimeout=6 "$DECK_SSH" true 2>/dev/null; then
    printf '  连通性    %s在线%s\n' "$G" "$N"
  else
    printf '  连通性    %s离线%s\n' "$R" "$N"
  fi

  hdr "服务"
  for s in $(services); do
    local e out
    e="$(svc_entry "$s")"
    if [ -x "$e" ]; then
      # 取 status 的第一行非空内容当摘要
      out="$("$e" status 2>/dev/null | sed -n '/[^[:space:]]/{s/^[[:space:]]*//;p;q;}')"
      printf '  %-12s %s\n' "$s" "${out:-—}"
    else
      printf '  %-12s %s(没有 service 入口)%s\n' "$s" "$D" "$N"
    fi
  done
  echo
}

cmd_status() {
  if [ $# -gt 0 ]; then
    local e; e="$(svc_entry "$1")"
    [ -x "$e" ] || die "服务「$1」没有 service 入口"
    exec "$e" status "${@:2}"
  fi
  local s
  for s in $(services); do
    local e; e="$(svc_entry "$s")"
    hdr "$s"
    if [ -x "$e" ]; then "$e" status; else warn "没有 service 入口"; fi
  done
  echo
}

cmd_doctor() {
  local bad=0
  hdr "环境体检（框架层）"

  chk() { # 名称 命令 说明 [soft]
    if eval "$2" >/dev/null 2>&1; then ok "$1"; else
      if [ "${4:-}" = "soft" ]; then warn "$1 —— $3"; else printf '%s✗%s %s —— %s\n' "$R" "$N" "$1" "$3"; bad=1; fi
    fi
  }

  chk "Deck 可达"        "ssh ${SSH_MUX[*]} -o BatchMode=yes -o ConnectTimeout=6 $DECK_SSH true" "检查 Deck 是否开机、SSH 是否开着"
  chk "Deck 免密 sudo"   "ssh ${SSH_MUX[*]} -o BatchMode=yes $DECK_SSH 'sudo -n true'" "见 docs/约定.md §4（root 操作要用）"
  chk "swiftc 可用"      "command -v swiftc" "xcode-select --install（编译菜单栏 App 用）" soft
  chk "菜单栏 App 已编译" "[ -d '$ROOT/menubar/DeckKit.app' ]" "deck menu" soft
  chk "菜单栏能正常出菜单" "[ -x '$ROOT/menubar/DeckKit.app/Contents/MacOS/DeckKit' ] && '$ROOT/menubar/DeckKit.app/Contents/MacOS/DeckKit' --dump | grep -q 'Steam Deck'" "deck menu 重新编译" soft
  # 装到 /Applications 的那份才是常驻的那个（它靠 Info.plist 的 DeckkitRoot 找回仓库）
  chk "菜单栏 App 已装到 /Applications" "[ -d '/Applications/DeckKit.app' ] && /Applications/DeckKit.app/Contents/MacOS/DeckKit --dump 2>/dev/null | grep -q 'Steam Deck'" "deck menu --install（没装也行，用仓库里那份）" soft

  # 全角字符紧跟 $VAR：macOS 自带 bash 3.2 会把全角标点的字节吃进变量名，
  # 运行时报 "unbound variable" —— 而且只在带中文字符串的那一行炸。
  # 这个坑已经踩过 6 次，所以放进体检里自动扫（见 docs/约定.md §7）。
  # 只看代码行：纯注释里的举例不算。
  local hits="" f hit
  for f in "$ROOT/bin/deck" "$SERVICES_DIR"/*/service "$SERVICES_DIR"/*/mac/*.env \
           "$SERVICES_DIR"/*/deck/*.sh "$ROOT/menubar/build.sh"; do
    [ -f "$f" ] || continue
    hit="$(perl -ne 'next if m{^\s*#}; print "行 $.: $_" if /\$[A-Za-z_][A-Za-z0-9_]*(?=[^\x00-\x7f])/' "$f" 2>/dev/null | head -3)"
    [ -n "$hit" ] && hits="${hits}${f}:
${hit}
"
  done
  if [ -n "$hits" ]; then
    printf '%s✗%s %s\n' "$R" "$N" "变量后面紧跟全角字符（bash 3.2 会报 unbound variable）："
    printf '%s\n' "$hits" | sed 's/^/      /'
    bad=1
  else
    ok "脚本里没有「变量紧跟全角字符」"
  fi

  echo
  printf '%s具体服务各自的依赖，由 deck status 里对应那行反映。%s\n' "$D" "$N"
  [ "$bad" = 0 ] && ok "没有硬性缺项" || warn "有硬性缺项，见上面 ✗"
  return 0
}

cmd_menu() {
  local script="$ROOT/menubar/build.sh"
  [ -x "$script" ] || die "找不到 $script"
  exec "$script" "$@"
}

# ── 服务自愈 / 主状态切换 ──
# ensure [服务]：对（指定的）服务做一次幂等修复。
# 没实现 ensure 的服务会把「不认识子命令」写到 stderr —— 这里丢掉，
# 于是调用方只会看到「真的动手修了」的输出。菜单栏就靠这个判断要不要刷新。
cmd_ensure() {
  local names s e out caps
  if [ $# -gt 0 ]; then names="$1"; else names="$(services)"; fi
  for s in $names; do
    e="$(svc_entry "$s")"
    [ -x "$e" ] || continue
    # 只对**声明了** ensure 的服务动手。能力靠 caps 显式声明，而不是
    # 「试探调用 + 吞掉报错」—— 后者分不清「没实现」和「实现但失败了」。
    caps="$("$e" caps 2>/dev/null | tr '\n' ' ')"
    case " ${caps} " in
      *" ensure "*) ;;
      *) continue ;;
    esac
    out="$("$e" ensure 2>/dev/null)"
    if [ -n "$out" ]; then
      printf '%s:\n' "$s"
      printf '%s\n' "$out" | sed 's/^/  /'
    fi
  done
}

# toggle <服务>：切换该服务的主状态（菜单栏点一下就转发到这里）。
# 只对声明了 toggle 能力的服务有效 —— 靠 `caps` 子命令问，别猜。
cmd_toggle() {
  [ $# -ge 1 ] || die "用法：deck toggle <服务>"
  local e caps
  e="$(svc_entry "$1")"
  [ -x "$e" ] || die "服务「${1}」没有 service 入口"
  caps="$("$e" caps 2>/dev/null | tr '\n' ' ')"
  case " ${caps} " in
    *" toggle "*) exec "$e" toggle ;;
    *) die "服务「${1}」不支持 toggle（它声明的可选子命令：${caps:-无}）" ;;
  esac
}

cmd_ssh()  { exec ssh "${SSH_MUX[@]}" "$DECK_SSH" "$@"; }
cmd_root() {
  [ $# -gt 0 ] || die "用法：deck root <命令>"
  exec ssh -t "${SSH_MUX[@]}" "$DECK_SSH" "sudo $*"
}
cmd_push() {
  [ $# -eq 2 ] || die "用法：deck push <本地文件> <Deck上路径>"
  local src="$1" dst="$2"
  case "$dst" in
    '~'|'~/'*)
      # scp 走 SFTP，不展开 ~（docs/约定.md §7）。远端 home 让 Deck 自己报，
      # 别在本地猜 —— 走复用的 SSH 连接，一次往返约 0.05 秒。
      # 也不能把 '~/...' 交给远端脚本自己剥：bash 对 "${p#~/}" 里的 word
      # 也会做 tilde 展开（展开成 $HOME/ 于是匹配不上），得写 "${p#\~}"。
      local home; home="$(ssh "${SSH_MUX[@]}" "$DECK_SSH" 'printf %s "$HOME"' 2>/dev/null)"
      [ -n "$home" ] || die "问不到 Deck 的 \$HOME"
      dst="${home}${dst#\~}"
      local base; base="$(basename "$dst")"
      scp "${SSH_MUX[@]}" "$src" "${DECK_SSH}:/tmp/deckkit-push-${base}" || exit 1
      exec ssh "${SSH_MUX[@]}" "$DECK_SSH" \
        "mkdir -p \"\$(dirname '$dst')\" && mv '/tmp/deckkit-push-${base}' '$dst' && echo \"✓ 已放到 $dst\""
      ;;
  esac
  exec scp "${SSH_MUX[@]}" "$src" "${DECK_SSH}:$dst"
}

# 秒 → 人类可读时长
fmt_dur() {
  local s="${1:-0}" d h m
  d=$((s / 86400)); h=$(((s % 86400) / 3600)); m=$(((s % 3600) / 60))
  if [ "$d" -gt 0 ]; then printf '%d天%d小时' "$d" "$h"
  elif [ "$h" -gt 0 ]; then printf '%dh%dm' "$h" "$m"
  else printf '%d分钟' "$m"; fi
}

# ── Deck 遥测：电量 / 充电状态 / 温度 / 运行时长 ──
# 全部读 sysfs，一次 SSH 拿完。菜单栏用 --json 调它，
# 所以「Deck 在不在线」和「电量温度」是同一趟往返，不会翻倍等待。
cmd_vitals() {
  local json=0
  [ "${1:-}" = "--json" ] && json=1

  # 注意：这段远程脚本里刻意不用 case 语句 —— macOS 自带 bash 3.2 在
  # "$( ... <<'EOF' ... EOF )" 里遇到 `case ... *)` 会解析错乱（见 docs/约定.md §7）。
  local raw rc
  raw="$(ssh "${SSH_MUX[@]}" -o BatchMode=yes -o ConnectTimeout=5 "$DECK_SSH" 'bash -s' <<'REMOTE' 2>/dev/null
cap=""; bstat=""; ac=""
for d in /sys/class/power_supply/*/; do
  [ -d "$d" ] || continue
  t="$(cat "$d/type" 2>/dev/null)"
  if [ "$t" = "Battery" ]; then
    cap="$(cat "$d/capacity" 2>/dev/null)"
    bstat="$(cat "$d/status" 2>/dev/null)"
  fi
  if [ "$t" = "Mains" ]; then
    ac="$(cat "$d/online" 2>/dev/null)"
  fi
done

apu=""; apu_alt=""; btemp=""
for h in /sys/class/hwmon/hwmon*/; do
  [ -d "$h" ] || continue
  n="$(cat "$h/name" 2>/dev/null)"
  if [ "$n" = "amdgpu" ] && [ -f "$h/temp1_input" ]; then apu="$(cat "$h/temp1_input")"; fi
  if [ "$n" = "acpitz" ] && [ -f "$h/temp1_input" ]; then apu_alt="$(cat "$h/temp1_input")"; fi
  if [ "$n" = "steamdeck_hwmon" ] && [ -f "$h/temp1_input" ]; then btemp="$(cat "$h/temp1_input")"; fi
done
[ -z "$apu" ] && apu="$apu_alt"

echo "cap=$cap"
echo "bstat=$bstat"
echo "ac=$ac"
echo "apu=$apu"
echo "btemp=$btemp"
echo "uptime=$(cut -d. -f1 /proc/uptime 2>/dev/null)"
echo "load=$(cut -d' ' -f1 /proc/loadavg 2>/dev/null)"
REMOTE
)"
  rc=$?

  vget() { printf '%s\n' "$raw" | sed -n "s/^$1=//p" | head -1; }
  # 毫摄氏度 → 摄氏度（一位小数）；空值给 null
  deg() { if [ -n "${1:-}" ]; then awk -v m="$1" 'BEGIN{printf "%.1f", m/1000}'; else printf 'null'; fi; }

  if [ "$rc" -ne 0 ] || [ -z "$raw" ]; then
    if [ "$json" = 1 ]; then printf '{"online":false}\n'; else die "Deck（${DECK_SSH}）不可达"; fi
    return 0
  fi

  local cap bstat ac apu btemp up load1
  cap="$(vget cap)"; bstat="$(vget bstat)"; ac="$(vget ac)"
  apu="$(vget apu)"; btemp="$(vget btemp)"; up="$(vget uptime)"; load1="$(vget load)"

  # 人类可读的充电状态。Deck 有电池保养：插着电也可能停在 ~80% 显示 Not charging。
  local chg=""
  if [ "$ac" = "1" ]; then
    if [ "$bstat" = "Charging" ]; then chg="充电中"
    elif [ "$bstat" = "Full" ]; then chg="已充满"
    elif [ "$bstat" = "Not charging" ]; then chg="已接电源（未充电）"
    else chg="已接电源"; fi
  elif [ "$ac" = "0" ]; then
    chg="使用电池"
  fi

  if [ "$json" = 1 ]; then
    printf '{"online":true,"capacity":%s,"status":"%s","ac":%s,"apu_c":%s,"bat_c":%s,"uptime_s":%s,"load1":%s}\n' \
      "${cap:--1}" "$bstat" "${ac:--1}" "$(deg "$apu")" "$(deg "$btemp")" "${up:--1}" "${load1:--1}"
    return 0
  fi

  printf 'Deck  电量 %s%%' "${cap:-?}"
  [ -n "$chg" ] && printf '（%s）' "$chg"
  local apu_c btemp_c
  apu_c="$(deg "$apu")"; btemp_c="$(deg "$btemp")"
  [ "$apu_c" != "null" ] && printf ' · APU %s°C' "$apu_c"
  [ "$btemp_c" != "null" ] && printf ' · 电池 %s°C' "$btemp_c"
  if [ "${up:--1}" -gt 0 ] 2>/dev/null; then printf ' · 已开机 %s' "$(fmt_dur "$up")"; fi
  [ -n "$load1" ] && printf ' · 负载 %s' "$load1"
  printf '\n'
}

# ---------------- 分发 ----------------
case "${1:-}" in
  ""|overview)        cmd_overview ;;
  list|ls)            cmd_list ;;
  brief|now)          cmd_brief ;;          # 精简：一个服务一行
  status)             shift; cmd_status "$@" ;;
  ssh)                shift; cmd_ssh "$@" ;;
  root)               shift; cmd_root "$@" ;;
  push)               shift; cmd_push "$@" ;;
  menu|menubar)       shift; cmd_menu "$@" ;;
  vitals)             shift; cmd_vitals "$@" ;;
  ensure)             shift; cmd_ensure "$@" ;;
  toggle)             shift; cmd_toggle "$@" ;;
  doctor)             cmd_doctor ;;
  -h|--help|help)     usage; cmd_cmds ;;
  self-install|path)  cmd_self_install ;;   # 把 deck 装到 PATH 上
  cmds|commands)      cmd_cmds ;;
  *)
    svc="$1"; shift
    e="$(svc_entry "$svc")"
    if [ -x "$e" ]; then
      exec "$e" "$@"
    elif [ -d "$SERVICES_DIR/$svc" ]; then
      die "服务「${svc}」存在，但没有可执行的 service 入口"
    else
      echo "未知命令或服务：$svc" >&2
      echo >&2
      usage >&2
      exit 2
    fi ;;
esac
