#!/usr/bin/env bash
# ============================================================
#  deckkit —— 公共库
#
#  为什么有它：4 个服务入口 + 框架本身各抄了一遍同一批东西 ——
#  cfg_get、颜色与 ok/warn/bad/die、SSH_MUX/SSH_OPTS/rsh/deck_up、slugify、
#  usage、「把参数 %q 引用后丢给远端脚本」。同一段代码有 4 份拷贝，
#  改一处要记得改四处（踩过：`slugify` 的截断长度已经分叉成 40/48）。
#  按 docs/约定.md §1「跨服务共享的东西放框架根」，全部收进这里。
#
#  用法（服务入口 / 框架脚本的头部）：
#      SVC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
#      . "$SVC_DIR/../../bin/deck-lib"          # Mac 侧服务
#      . "${HOME}/deckkit/bin/deck-lib"         # Deck 侧脚本
#
#  两条纪律：
#    1. 本文件**只有定义，没有副作用**（唯一例外：按是否接终端决定颜色值），
#       可以安全地重复 source；不设 set -e/-u（那是调用方的事）。
#    2. 只写 bash 3.2 能跑的语法 —— macOS 自带的就是它（见 §9 踩过的坑）。
# ============================================================

# ───────────────────────────── 终端样式 ─────────────────────────────
# 同一套颜色有两种叫法：框架用 B/G/Y/R/D/N，服务用 C_B/C_GRN/… ——
# 两套都定义（同一份值），这样接库时不用把每个 printf 都改一遍。
if [ -t 1 ] && [ -z "${DECKKIT_NO_COLOR:-}" ]; then
  C_RST=$'\033[0m'; C_B=$'\033[1m'; C_DIM=$'\033[2m'
  C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YEL=$'\033[33m'; C_CYN=$'\033[36m'
else
  C_RST=""; C_B=""; C_DIM=""; C_RED=""; C_GRN=""; C_YEL=""; C_CYN=""
fi
B="$C_B"; G="$C_GRN"; Y="$C_YEL"; R="$C_RED"; D="$C_DIM"; CY="$C_CYN"; N="$C_RST"

# 消息。约定 §2：状态输出带符号 —— ✓ 正常 / ! 注意 / ✗ 出错。
say()  { printf '%s\n' "$*"; }
hdr()  { printf '\n%s%s%s\n' "$C_B" "$*" "$C_RST"; }
dim()  { printf '  %s%s%s\n' "$C_DIM" "$*" "$C_RST"; }
ok()   { printf '  %s\xe2\x9c\x93%s %s\n' "$C_GRN" "$C_RST" "$*"; }
warn() { printf '  %s!%s %s\n' "$C_YEL" "$C_RST" "$*"; }
bad()  { printf '  %s\xe2\x9c\x97%s %s\n' "$C_RED" "$C_RST" "$*"; }
die()  { printf '  %s\xe2\x9c\x97%s %s\n' "$C_RED" "$C_RST" "$*" >&2; exit 1; }
# 用法/参数错误：退出码 2（脚本自己在 case 里用 die 报业务错误，保持 1）
die_usage() { printf '  %s\xe2\x9c\x97%s %s\n' "$C_RED" "$C_RST" "$*" >&2; exit 2; }

# ─────────────────────────── 用法 / 头部注释 ───────────────────────────
# 约定：脚本第 1 行是 shebang，第 2 行起是**连续的注释块**（空行也写成 `#`），
# 那一块就是 usage。以前各脚本写 `sed -n '2,20p' "$0"` 把行号硬编码进去，
# 头注释一变（加了两行就说明）usage 就被切断 —— 现在从头注释块直接算。
deckkit_usage_of() {
  sed -n '2,/^[^#]/p' "$1" 2>/dev/null | sed -n 's/^# \{0,1\}//p' | sed '/^=\{10,\}$/d'
}
usage() { deckkit_usage_of "${BASH_SOURCE[1]:-$0}"; }

# ───────────────────────────── 配置 ─────────────────────────────
# 读 mac/config.env 的一个键：**不 source**（约定 §2：source 会污染环境，
# 而且配置文件里写的是给人看的，不是可执行代码）。
#   deckkit_cfg KEY [文件]     文件默认 $MAC_DIR/config.env
deckkit_cfg() {
  local key="$1" f="${2:-${MAC_DIR:-.}/config.env}"
  [ -f "$f" ] || return 0
  sed -n "s/^${key}=[\"']\{0,1\}\([^\"'#]*\).*/\1/p" "$f" 2>/dev/null \
    | head -1 | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}
# 带默认值：deckkit_cfg_or KEY 默认值 [文件]
deckkit_cfg_or() {
  local v
  if [ -n "${3:-}" ]; then v="$(deckkit_cfg "$1" "$3")"; else v="$(deckkit_cfg "$1")"; fi
  printf '%s' "${v:-$2}"
}

# ─────────────────────────── 框架根目录 ───────────────────────────
# $DECKKIT_ROOT（框架自己导出的）→ 由调用方的 $SVC_DIR 往上推两级 → 本库所在目录的上一级
deckkit_root() {
  if [ -n "${DECKKIT_ROOT:-}" ]; then printf '%s' "$DECKKIT_ROOT"; return 0; fi
  if [ -n "${SVC_DIR:-}" ]; then printf '%s' "$(cd "$SVC_DIR/../.." 2>/dev/null && pwd)"; return 0; fi
  printf '%s' "$(cd "$(dirname "${BASH_SOURCE[1]:-$0}")/.." 2>/dev/null && pwd)"
}

# ─────────────────────────────── SSH ───────────────────────────────
# 连接复用（约定 §3）：一轮刷新要开 6~8 个连接，每次重新握手约 0.19 秒，
# 不复用一轮就是 2.6 秒 —— 用户看到的是「状态更新慢半拍」。实测 → 0.3 秒。
# ControlPersist **不要**调长：刷新间隔 30 秒，调长等于对 Deck 保持常连。
#
# 用法：先把 DECK_SSH / SSH_TIMEOUT 设好（通常来自 config.env），再调
#   deckkit_ssh_init      定义 SSH_MUX / SSH_BASE / SSH_OPTS / SSH_TTY_OPTS
# 然后就可以用 rsh / rsh_tty / rsh_script / deck_up / require_deck。
deckkit_ssh_init() {
  : "${DECK_SSH:=deck}"
  : "${SSH_TIMEOUT:=10}"
  DECKKIT_SSH_TARGET="${DECKKIT_DECK_SSH:-$DECK_SSH}"
  DECK_HOST="${DECK_HOST:-steamdeck.local}"
  SSH_MUX=(-o ControlMaster=auto -o ControlPath="$HOME/.ssh/deckkit-cm-%r@%h:%p" -o ControlPersist=15s)
  SSH_BASE=(-o ConnectTimeout="$SSH_TIMEOUT" -o StrictHostKeyChecking=accept-new "${SSH_MUX[@]}")
  SSH_OPTS=(-o BatchMode=yes "${SSH_BASE[@]}")
  # 交互用（-t 由 rsh_tty 按 [ -t 0 ] 决定，约定 §9）
  SSH_TTY_OPTS=("${SSH_BASE[@]}")
}

rsh() { ssh "${SSH_OPTS[@]}" "$DECKKIT_SSH_TARGET" "$@"; }

# 需要 TTY 时才加 -t（免密 sudo 不需要 TTY；菜单栏/CI 这类没有终端的环境
# 带 -t 会直接失败）。bash 3.2 在 set -u 下展开空数组会报 unbound variable，
# 所以一律写 "${arr[@]+"${arr[@]}"}"。
rsh_tty() {
  local t=()
  [ -t 0 ] && t=(-t)
  ssh ${t[@]+"${t[@]}"} "${SSH_TTY_OPTS[@]}" "$DECKKIT_SSH_TARGET" "$@"
}

# 参数安全引用的公共写法：远端命令串里塞本地变量一律走这里
# （printf %q 会处理引号/空格/分号；`$id` 直接拼进远端命令串等于注入）。
deckkit_quote_args() {
  local args="" a
  for a in "$@"; do args="$args $(printf '%q' "$a")"; done
  printf '%s' "$args"
}

# 跑远端脚本：脚本从 stdin 进来，位置参数已安全引用。
# XDG_RUNTIME_DIR 顺手补上 —— systemd --user 在非登录 ssh 会话里拿不到它，
# 每个调用点各写一遍这条 export 是同一个坑的第 N 份拷贝。
rsh_script() {
  local args; args="$(deckkit_quote_args "$@")"
  ssh "${SSH_OPTS[@]}" "$DECKKIT_SSH_TARGET" \
    "export XDG_RUNTIME_DIR=\${XDG_RUNTIME_DIR:-/run/user/\$(id -u)}; bash -s --$args"
}

# 跑 Deck 上的固定脚本（gamectl.sh / patchctl.sh 这类），参数自动引用
deckkit_remote_script() {   # <远端脚本路径> [参数...]
  local script="$1"; shift
  local args; args="$(deckkit_quote_args "$@")"
  ssh "${SSH_OPTS[@]}" "$DECKKIT_SSH_TARGET" "bash $(printf '%q' "$script")$args"
}

# 上一次 deck_up 的 ssh 原始 stderr。为什么留着：约定 §7 —— 失败必须带原始
# 原因。光有「连不上」三个字，分不出是没开机、SSH 没开、还是名字解析不了。
deckkit_ssh_err=""
# 注意用 rc 判成败、不是「stderr 是不是空的」：ssh 会打一些无害的警告
#（比如 ControlSocket 已存在就退回复用），拿 stderr 当判据会把成功报成失败。
deck_up() {
  local err rc
  err="$(ssh "${SSH_OPTS[@]}" "$DECKKIT_SSH_TARGET" true 2>&1 >/dev/null)"; rc=$?
  deckkit_ssh_err="$err"
  return $rc
}
require_deck() {
  deck_up && return 0
  die "${1:-Deck（${DECKKIT_SSH_TARGET:-$DECK_SSH}）连不上 —— 确认开机、SSH 打开、同一网段}${deckkit_ssh_err:+（原始报错：${deckkit_ssh_err%%$'\n'*}}）"
}

# 把一个本地文件写到 Deck 上的**绝对路径**（内容走 stdin，不经过 scp/SFTP）。
#
# 两条为什么：
#   ① 远端路径必须 %q 引用 —— 引号里的 `~` 不展开（会写进一个真名叫 `~` 的
#      目录，踩过）、路径里有空格/分号就是注入；
#   ② **先写远端临时文件再 mv** —— 半截传输（断网、EOF）不会把 Deck 上已有的
#      manifest / meta / 单元文件截成空文件。空文件比报错难查得多（一个空
#      manifest 在 status 里等于「状态未知」）。
rsh_put() {   # <本地文件> <远端绝对路径>
  local src="$1" q
  [ -f "$src" ] || { warn "要上传的文件不存在：$src"; return 1; }
  case "$2" in /*) ;; *) warn "远端路径要给绝对路径：$2"; return 1 ;; esac
  q="$(printf '%q' "$2")"
  ssh "${SSH_OPTS[@]}" "$DECKKIT_SSH_TARGET" \
    "t=$q.deckkit-tmp; if cat > \"\$t\"; then mv -f \"\$t\" $q; else rm -f \"\$t\"; exit 1; fi" < "$src"
}

# ───────────────────────────── 命名 / 数值 ─────────────────────────────
# 目录名 → slug。**保留 \w（含中日文）**：汉化补丁、同人游戏的名字经常整段是
# 中文/日文，老规则只留 [a-z0-9] 会把名字削成空字符串，只能逼人 --name。
# 长度上限按用途给：Deck 上的目录名短一点（40），补丁库宽一点（48）。
deckkit_slug() {   # <名字> [最大长度]
  python3 -c '
import re, sys
s = re.sub(r"\.(exe|zip|7z|rar|tar|gz|tgz|xz)$", "", sys.argv[1], flags=re.I).lower()
out = re.sub(r"[^\w]+", "-", s, flags=re.U).strip("-_")[:int(sys.argv[2])].strip("-_")
print(out)
' "$1" "${2:-48}"
}

# 字节 → 人类可读
deckkit_human() {
  local b="${1:-0}"
  awk -v b="$b" 'BEGIN{ split("B KiB MiB GiB TiB",u," "); i=1; while (b>=1024 && i<5){b/=1024;i++} printf (i==1?"%d %s":"%.1f %s"), b, u[i] }'
}

# 秒 → 人类可读（菜单栏 tooltip 与 deck vitals 用同一套说法）
deckkit_duration() {
  local s="${1:-0}" d h m
  d=$((s / 86400)); h=$(((s % 86400) / 3600)); m=$(((s % 3600) / 60))
  if [ "$d" -gt 0 ]; then printf '%d天%d小时' "$d" "$h"
  elif [ "$h" -gt 0 ]; then printf '%dh%dm' "$h" "$m"
  else printf '%d分钟' "$m"; fi
}

# ─────────────────────────────── 日志 ───────────────────────────────
# 统一入口是 bin/deck-log（Deck 侧 ~/deckkit/bin/deck-log）。约定 §7：
# 只记对 debug 有用的东西 —— 状态变化、失败原因、用户动作、生命周期锚点。
# 日志是辅助不是依赖：工具不在就静默跳过，绝不因为它缺失让服务挂掉。
deckkit_log_tool() {
  local r; r="$(deckkit_root 2>/dev/null)"
  if [ -n "$r" ] && [ -x "$r/bin/deck-log" ]; then printf '%s' "$r/bin/deck-log"; return 0; fi
  if [ -x "${HOME}/deckkit/bin/deck-log" ]; then printf '%s' "${HOME}/deckkit/bin/deck-log"; return 0; fi
  return 1
}
deckkit_log() {   # <来源> <消息...>
  local t; t="$(deckkit_log_tool)" || return 0
  "$t" "$@" >/dev/null 2>&1 || true
}
deckkit_log_path() {   # <来源> → 日志文件路径（拿不到就回落到 ~/deckkit/logs）
  local t; t="$(deckkit_log_tool)" || { printf '%s/%s.log' "${HOME}/deckkit/logs" "$1"; return 0; }
  "$t" --path "$1" 2>/dev/null || printf '%s/%s.log' "${HOME}/deckkit/logs" "$1"
}
# 流式日志（node/proton 的原始输出）启动时：轮转一代 + 写一条带时间戳的锚点。
# 锚点是必需的 —— 那些程序的输出不带时间戳，没有锚点就分不清哪段属于哪一次。
# 流式日志（node/proton 的原始输出）启动时：轮转一代 + 写一条带时间戳的锚点。
# 锚点是必需的 —— 那些程序的输出不带时间戳，没有锚点就分不清哪段属于哪一次。
#
# **返回码如实**：轮转失败（磁盘满/权限）意味着这个日志从此只增不减，调用方
# 该知道。不想管就自己 `|| true` —— 但别让库替调用方决定（以前这里吞掉失败，
# 结果没人知道轮转没生效）。
deckkit_log_rotate() {   # <来源> [锚点文字]
  local t rc
  t="$(deckkit_log_tool)" || return 0          # 没有日志工具就静默跳过（日志不是依赖）
  "$t" --rotate "$1" >/dev/null 2>&1 || rc=$?
  if [ $# -ge 2 ] && [ -n "$2" ]; then
    "$t" "$1" "$2" >/dev/null 2>&1 || rc=$?
  fi
  return "${rc:-0}"
}

# ───────────────────────── Deck 侧通用件 ─────────────────────────
# 这些在 Deck 上跑（gamectl.sh / patchctl.sh 各有一份拷贝）。

DECK_STEAM="${DECK_STEAM:-$HOME/.steam/steam}"
deckkit_compat_dir()  { printf '%s/steamapps/compatdata' "$DECK_STEAM"; }
deckkit_protons_dir() { printf '%s/steamapps/common' "$DECK_STEAM"; }

deckkit_protons() {
  local d
  for d in "$(deckkit_protons_dir)"/Proton*; do
    [ -d "$d" ] || continue
    [ -x "$d/proton" ] && basename "$d"
  done
}
# 最新一版 Proton：数字版里最大的优先，其次 Experimental/Hotfix
deckkit_pick_proton() {
  [ -n "${PROTON:-}" ] && { printf '%s' "$PROTON"; return 0; }
  local p
  p="$(deckkit_protons | grep -E '^Proton [0-9]' | sort -t' ' -k2 -V | tail -1)"
  [ -n "$p" ] || p="$(deckkit_protons | grep -i experimental | head -1)"
  [ -n "$p" ] || p="$(deckkit_protons | head -1)"
  [ -n "$p" ] || return 1
  printf '%s' "$p"
}

# 文件清单快照：<相对路径>\t<字节数>\t<mtime>，按路径排序。
#   exit 0 = find 完全跑通（输出可以是空的 —— 空目录是合法结果）
#   exit 1 = 目录不存在，或 find 有读不了的子树（**列表不完整**，别当成「没变化」）
# 这个是必须的：老写法 `find … 2>/dev/null | sort` 整条的退出码来自 sort（恒 0），
# 于是调用方的 `|| die "快照失败"` 永远不触发 —— 空清单被当成「安装前后一个文件
# 都没变」，把执行失败报成安装失败（踩过）。
# 读不了时**照样把已经读到的那部分打出来**：调用方不看 rc 时还有数据可用，
# 看 rc 就知道这份清单不完整。
deckkit_snapshot() {   # <目录>
  local dir="$1" out rc
  [ -d "$dir" ] || return 1
  out="$(find "$dir" -type f -printf '%P\t%s\t%T@\n' 2>/dev/null)"; rc=$?
  [ -n "$out" ] && printf '%s\n' "$out" | sort
  return "$rc"
}

# 桌面会话凭证：ssh 进来时环境里既没有 DISPLAY 也没有 XAUTHORITY，
# 硬写 DISPLAY=:0 会 "Authorization required"（Wine 开不出窗口、安装器干等）。
# 从正在跑的桌面会话进程里读出来。
deckkit_display_env() {
  if [ -z "${DISPLAY:-}" ] || [ -z "${XAUTHORITY:-}" ]; then
    local sp="" n
    for n in plasmashell kwin_wayland steam; do
      sp="$(pgrep -x "$n" 2>/dev/null | head -1)"
      [ -n "$sp" ] && break
    done
    if [ -n "$sp" ] && [ -r "/proc/$sp/environ" ]; then
      # 逐行 export，不用 eval：eval "$(…| sed 's/^/export /')" 在
      # XAUTHORITY 含空格/引号/分号时会破相（可用值注入），而且那是把
      # 陌生内容交给 shell 重新解析。
      while IFS= read -r kv; do
        case "$kv" in
          DISPLAY=*|XAUTHORITY=*|WAYLAND_DISPLAY=*) export "$kv" ;;
        esac
      done < <(tr '\0' '\n' < "/proc/$sp/environ" | grep -E '^(DISPLAY|XAUTHORITY|WAYLAND_DISPLAY)=')
    fi
  fi
}
# 预检：连不上桌面就直接报错，别让安装器在看不见的地方干等
deckkit_require_display() {
  deckkit_display_env
  [ -n "${DISPLAY:-}" ] || die "拿不到 Deck 的桌面会话（DISPLAY）—— Deck 需要在桌面模式下"
  if ! xprop -root >/dev/null 2>&1; then
    die "连不上 Deck 的桌面（DISPLAY=${DISPLAY} XAUTHORITY=${XAUTHORITY:-未设置}）—— 确认 Deck 在桌面模式。这一项不通过，安装器不会有窗口，只会干等"
  fi
}

# 跑 protontricks 式的一次性 Proton 命令共用环境
deckkit_proton_env() {   # <prefix> [proton]
  export STEAM_COMPAT_CLIENT_INSTALL_PATH="$DECK_STEAM"
  export STEAM_COMPAT_DATA_PATH="$1"
  # Xalia：Proton 注入的手柄导航 .NET 组件，在非 Steam 上下文里必崩
  # （日志 Unhandled exception in Xalia → 窗口从不出现）。我们自己关掉它。
  export PROTON_USE_XALIA=0
}

# ───────────────────────── 服务契约小工具 ─────────────────────────
# caps：声明实现了哪些可选子命令（约定 §2.1）。框架问「点一下是切换还是看详情」
# 就靠它，不靠试探调用 —— 试探分不清「没实现」和「实现但失败了」。
deckkit_caps_has() {   # <service入口> <子命令>
  local caps
  caps="$("$1" caps 2>/dev/null | tr '\n' ' ')"
  case " ${caps} " in *" $2 "*) return 0 ;; *) return 1 ;; esac
}
