#!/usr/bin/env bash
# ============================================================
#  deckkit / games —— 用户配置
#
#  把 Windows 游戏（exe 安装器）装到 Steam Deck 上，自动做掉除"点安装"以外的配置：
#  新建 Proton prefix、在 Deck 桌面会话里拉起安装器、安装前后快照、
#  生成启动脚本、登记 Steam 非 Steam 快捷方式。
# ============================================================

# ---------- Deck 连接 ----------
DECK_SSH="deck"                    # ~/.ssh/config 别名（强 AddressFamily inet）
DECK_HOST="steamdeck.local"        # 只用于显示/报错
DECK_HOME="/home/deck"             # Deck 上的家目录（scp/ssh 里远端 ~ 不一定展开，拼绝对路径用）

# ---------- Deck 侧布局 ----------
# 安装包永久的家：store/<slug>/setup.exe，另存 meta.tsv 记录 appid/prefix 等信息
DECK_GAMES_ROOT="~/deckkit/services/games"

# ---------- 其它 ----------
SSH_TIMEOUT=10
