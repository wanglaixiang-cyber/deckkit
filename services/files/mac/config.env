#!/usr/bin/env bash
# ============================================================
#  deckkit / files —— 用户配置
#
#  把 Deck 的**家目录**通过 NFS 共享给 Mac（Finder 侧边栏「deck」），
#  rclone WebDAV 作为 NFS 不可用时的回退通道。
# ============================================================

# ---------- Deck 连接 ----------
DECK_HOST="steamdeck.local"      # mDNS 名字；菜单栏/状态探测用
DECK_SSH="deck"                  # ~/.ssh/config 里的别名（强 AddressFamily inet）

# ---------- 共享目录 ----------
# Deck 上要被共享的目录。默认是家目录根（/home/deck）。
# 想只共享某个子目录，改成比如 /home/deck/Documents。
DECK_NFS_DIR="/home/deck"

# 允许访问的客户端网段（写进 Deck 的 /etc/exports）
CLIENT_NET="10.0.0.0/24"

# ---------- Mac 侧挂载点 ----------
# 走 Finder 的 mount volume 挂载时，卷名取决于导出路径的最后一段：
# /home/deck → /Volumes/deck。改了 DECK_NFS_DIR 这里也要跟着改。
MOUNT_POINT="/Volumes/deck"

# ---------- WebDAV 回退通道 ----------
# Deck 上用 rclone serve webdav 共享同一个目录。
# NFS 被防火墙挡住或挂不上时用：Finder cmd+K → http://steamdeck.local:8088
WEBDAV_PORT=8088
WEBDAV_UNIT="rclone-webdav"
