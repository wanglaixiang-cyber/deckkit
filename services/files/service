#!/usr/bin/env bash
# ============================================================
#  deckkit / files —— 服务入口
#
#    deck files status               状态一览
#    deck files mount                挂载 Deck 家目录（会进访达侧边栏）
#    deck files ensure               幂等修复：没挂上就挂上（菜单栏会定期调）
#    deck files toggle               切换挂载/卸载（菜单栏点一下就走它）
#    deck files unmount              卸载
#    deck files open                 在访达里打开挂载点
#    deck files url                  打印 NFS / WebDAV 地址
#    deck files provision [选项]     在 Deck 上配置 NFS 导出（root，幂等）
#    deck files webdav install      安装并启用 WebDAV 回退通道
#    deck files webdav on|off|status
# ============================================================
set -uo pipefail

SVC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAC_DIR="${SVC_DIR}/mac"
DECK_DIR="${SVC_DIR}/deck"
DECKKIT_ROOT="$(cd "$SVC_DIR/../.." && pwd)"
# 颜色、消息、cfg、SSH 复用都在公共库（见 docs/约定.md §1）
# shellcheck source=../../bin/deck-lib
. "${DECKKIT_ROOT}/bin/deck-lib"

DECK_HOST="$(deckkit_cfg_or DECK_HOST steamdeck.local)"
DECK_SSH="$(deckkit_cfg_or DECK_SSH deck)"
NFS_DIR="$(deckkit_cfg_or DECK_NFS_DIR /home/deck)"
CLIENT_NET="$(deckkit_cfg_or CLIENT_NET 10.0.0.0/24)"
MOUNT_POINT="$(deckkit_cfg_or MOUNT_POINT /Volumes/deck)"
WEBDAV_PORT="$(deckkit_cfg_or WEBDAV_PORT 8088)"
WEBDAV_UNIT="$(deckkit_cfg_or WEBDAV_UNIT rclone-webdav)"
SSH_TIMEOUT="$(deckkit_cfg_or SSH_TIMEOUT 6)"
deckkit_ssh_init

# 本服务的叫法沿用 deck_sh（更贴「跟 Deck 说话」这件事）
deck_sh()  { rsh "$@"; }
deck_sys() { rsh "export XDG_RUNTIME_DIR=\${XDG_RUNTIME_DIR:-/run/user/\$(id -u)}; systemctl --user $*"; }

# ── 「期望状态」标记 ──
# 用来区分两种「没挂上」：
#   用户手动卸载了  → 记 off，ensure 不许自作主张挂回来
#   挂载自己掉了    → 记 on（或没记录），ensure 负责补回来
# 没有这个标记，定期自愈就一定会和用户的手动卸载打架。
STATE_DIR="${HOME}/Library/Application Support/deckkit"
WANT_FILE="${STATE_DIR}/files.want"
want_get() { [ -f "$WANT_FILE" ] && cat "$WANT_FILE" 2>/dev/null; return 0; }
want_set() { mkdir -p "$STATE_DIR" 2>/dev/null; printf '%s\n' "$1" > "$WANT_FILE" 2>/dev/null; return 0; }

deck_online()   { deck_up; }

# 这个 NFS 源**实际**挂在哪儿（问 mount 表，不是问配置）。
#
# 为什么不能只比对 $MOUNT_POINT：Finder 的 `mount volume` 在目标名被占时
# 会自己改成 `deck-1`（实测：卸载后紧接着挂，/Volumes/deck 还没来得及消失，
# 于是就挂到了 /Volumes/deck-1）。而那时 /Volumes/deck 上什么也没有 ——
# 旧代码只会报「挂载失败」，把「挂到别处去了」误诊成「没挂上」，
# 用户对着一个空目录查半天。
# 用 index() 而不是正则：源里带 / 和 . ，正则会踩坑。
nfs_mount_point() {
  mount 2>/dev/null | awk -v src="${DECK_HOST}:${NFS_DIR}" '
    index($0, src " on ") == 1 { sub(/^.* on /, ""); sub(/ \(.*/, ""); print; exit }'
}
# rsh_put 只收绝对路径（远端 ~ 在引号里不展开，§9），所以先问一次 $HOME 并缓存
DECK_HOME_CACHE=""
deck_home() {
  if [ -z "$DECK_HOME_CACHE" ]; then
    DECK_HOME_CACHE="$(rsh 'printf %s "$HOME"' 2>/dev/null)"
    [ -n "$DECK_HOME_CACHE" ] || die "问不到 Deck 的 \$HOME"
  fi
  printf '%s' "$DECK_HOME_CACHE"
}
# 挂上了 = 这个源在 mount 表里（**任何**挂载点都算）
mount_present() { [ -n "$(nfs_mount_point)" ]; }

# 挂载点存在但没响应 = Deck 睡了留下的陈旧挂载（stat 会一直阻塞，所以要带闹钟）
mount_alive() {
  local mp; mp="$(nfs_mount_point)"
  [ -n "$mp" ] || return 1
  python3 - "$mp" <<'PY' 2>/dev/null
import os, signal, sys
signal.signal(signal.SIGALRM, lambda *a: sys.exit(1)); signal.alarm(3)
try: os.stat(sys.argv[1])
except Exception: sys.exit(1)
sys.exit(0)
PY
}

nfs_port_open() {
  deck_sh 'ss -ltn 2>/dev/null | grep -q ":2049 "' 2>/dev/null
}

webdav_state() {
  deck_sys "is-active $WEBDAV_UNIT" 2>/dev/null | head -1
}

# ---------------------------------------------------------------- status ---
cmd_status() {
  local online=0 mounted=0 alive=0
  deck_online && online=1
  mount_present && mounted=1
  mount_alive && alive=1

  local mp; mp="$(nfs_mount_point)"
  if [ "$alive" = 1 ]; then
    printf '%s✓%s 已挂载 %s ← %s:%s\n' "$G" "$N" "${mp:-$MOUNT_POINT}" "$DECK_HOST" "$NFS_DIR"
  elif [ "$mounted" = 1 ]; then
    printf '%s!%s %s 已挂载但无响应（Deck 可能睡了）\n' "$Y" "$N" "$MOUNT_POINT"
  elif [ "$(want_get)" = "off" ]; then
    printf '%s!%s 已手动卸载 %s（deck files mount 可挂回）\n' "$Y" "$N" "$MOUNT_POINT"
  elif [ "$online" = 1 ]; then
    printf '%s!%s 未挂载（Deck 在线，会自动补挂）\n' "$Y" "$N"
  else
    printf '%s✗%s Deck 离线（%s）\n' "$R" "$N" "$DECK_HOST"
  fi

  if [ "$online" = 1 ]; then
    printf '  Deck        %s在线%s  %s\n' "$G" "$N" "$DECK_HOST"
    if nfs_port_open; then printf '  NFS 端口    %s2049 已开放%s\n' "$G" "$N"
    else                    printf '  NFS 端口    %s未开放%s（deck files provision）\n' "$Y" "$N"; fi
    local exp; exp="$(deck_sh "sudo -n exportfs -v 2>/dev/null | grep -F '$NFS_DIR ' | head -1" 2>/dev/null)"
    if [ -n "$exp" ]; then printf '  NFS 导出    %s已导出%s  %s\n' "$G" "$N" "$(printf '%s' "$exp" | tr -s ' ')"
    else                   printf '  NFS 导出    %s未配置%s\n' "$Y" "$N"; fi
  else
    printf '  Deck        %s离线%s  %s\n' "$R" "$N" "$DECK_HOST"
  fi

  if [ "$alive" = 1 ]; then printf '  挂载        %s可读写%s  %s\n' "$G" "$N" "$MOUNT_POINT"
  elif [ "$mounted" = 1 ]; then printf '  挂载        %s陈旧%s（sudo umount -f %s）\n' "$Y" "$N" "$MOUNT_POINT"
  else printf '  挂载        %s未挂载%s\n' "$D" "$N"; fi

  if [ "$online" = 1 ]; then
    local wd; wd="$(webdav_state)"
    if [ "$wd" = "active" ]; then printf '  WebDAV      %sactive%s  http://%s:%s\n' "$G" "$N" "$DECK_HOST" "$WEBDAV_PORT"
    else printf '  WebDAV      %s%s%s（回退通道）\n' "$Y" "${wd:-未知}" "$N"; fi
  fi
  echo
}

# 清掉「挂着但没响应」的陈旧挂载 —— Deck 睡过之后最常见。
# 用户级 umount 对卡死的 NFS 常常无效，所以再补一次 diskutil 的强制卸载；
# 还是清不掉就只能人工 sudo（那种情况内核已经把这个挂载点锁住了）。
# 作用在**实际挂载点**上：源可能被 Finder 挂到了 deck-1 那种地方（见 nfs_mount_point）。
clear_stale_mount() {
  local mp; mp="$(nfs_mount_point)"; [ -n "$mp" ] || mp="$MOUNT_POINT"
  umount "$mp" 2>/dev/null \
    || diskutil unmount force "$mp" >/dev/null 2>&1 \
    || true
  sleep 1
  mount_present && return 1
  return 0
}

# ----------------------------------------------------------------- mount ---
# 实际挂一次。cmd_mount（用户手动）和 cmd_ensure（每轮自愈）走的是同一段 ——
# 以前这两处各写一遍，改一处忘一处（比如"先探 2049 再调 osascript"这条
# 就只在其中一处有）。
mount_now() {
  # 先探 2049：对着没开 NFS 的主机调 osascript 会干等 40 多秒（实测 46s）
  nfs_port_open || { warn "Deck 的 NFS 端口 2049 没开。先在 Mac 上跑：deck files provision"; return 1; }

  # 名字被占的话 Finder 会挂到 deck-1（见 nfs_mount_point），所以先让位：
  # 只在 $MOUNT_POINT 存在、且**不是**本源的挂载点时才动，而且只删空目录 ——
  # 里面有东西就当它是用户的真实数据，绝不碰（约定 §6）。
  if [ -d "$MOUNT_POINT" ] && [ "$(nfs_mount_point)" != "$MOUNT_POINT" ]; then
    if rmdir "$MOUNT_POINT" 2>/dev/null; then
      dim "  清掉挡名字的空目录 $MOUNT_POINT"
    else
      warn "$MOUNT_POINT 被占用（不是本源的挂载点，且非空）—— Finder 可能挂到 ${MOUNT_POINT}-1"
    fi
  fi

  finder_mount
  local mp; mp="$(nfs_mount_point)"
  # 落在别处、而配置的那个名字现在空着 → 收掉重挂一次。
  # 这是实测出来的：`umount` 刚返回时内核里那条 autofs 记录还没消失，
  # Finder 就以为名字被占、于是挂到 deck-1；隔一秒再挂就正常了。
  if [ -n "$mp" ] && [ "$mp" != "$MOUNT_POINT" ] && [ ! -d "$MOUNT_POINT" ]; then
    warn "先落在了 ${mp}（${MOUNT_POINT} 一时没让开），收掉重挂一次"
    umount "$mp" 2>/dev/null || diskutil unmount force "$mp" >/dev/null 2>&1 || true
    sleep 1
    finder_mount
    mp="$(nfs_mount_point)"
  fi
  [ -n "$mp" ] || return 1
  if [ "$mp" != "$MOUNT_POINT" ]; then
    # 挂上了，但不在配置的路径上 —— 必须说清楚，别报「没挂上」
    warn "Finder 把它挂到了 ${mp}（配置里是 ${MOUNT_POINT}；名字被占时 Finder 会自动加 -1）"
  fi
  mount_alive
}

# 让 Finder 挂，然后等它出现在 mount 表里。
# 挂载不是瞬时的：轮询而不是死等固定秒数（Finder 那条路要跟 NetAuthSysAgent 说话，
# 慢的时候 2 秒真不够，然后就报「挂载失败」）。
finder_mount() {
  osascript -e "mount volume \"nfs://${DECK_HOST}${NFS_DIR}\"" >/dev/null 2>&1
  local i=0
  while [ "$i" -lt 16 ]; do
    [ -n "$(nfs_mount_point)" ] && return 0
    sleep 0.5; i=$((i + 1))
  done
  return 1
}
cmd_mount() {
  deck_online || die "Deck 离线（${DECK_HOST}），先把它唤醒"
  want_set on                          # 记下「用户要它挂着」
  if mount_alive; then ok "已挂载：$MOUNT_POINT"; return 0; fi
  if mount_present; then
    # 陈旧挂载不能直接 die 掉：菜单栏点一下就想挂回来，结果只得到一句
    # 「先自己 sudo」是不合理的 —— 这里跟 ensure 走同一条自愈路径。
    warn "检测到陈旧挂载（Deck 睡过留下的），先尝试清掉"
    clear_stale_mount || die "陈旧挂载清不掉，需要人工：sudo umount -f '$MOUNT_POINT'"
  fi
  echo "… 通过访达挂载 nfs://${DECK_HOST}${NFS_DIR}"
  if mount_now; then ok "挂载成功：$(nfs_mount_point)"
  else die "挂载失败。可试 Finder cmd+K → nfs://${DECK_HOST}${NFS_DIR}"; fi
}

cmd_unmount() {
  want_set off                         # 记下「用户不要它挂着」，ensure 之后不会自作主张
  mount_present || { warn "本来就没有挂载"; return 0; }
  if umount "$MOUNT_POINT" 2>/dev/null; then ok "已卸载 $MOUNT_POINT"; return 0; fi
  die "卸载失败（可能还被占用）。强制卸载：sudo umount -f '$MOUNT_POINT'"
}

# ensure：幂等的「修好它」。挂载会自己掉（Deck 睡了、NFS 客户端超时……），
# 这个动作把它补回来（见 docs/约定.md §2.1）。
# 一切正常时**不输出任何内容**，所以可以每轮刷新都安静地调一次。
cmd_ensure() {
  # 用户手动卸载过 → 尊重它，绝不自动挂回来。
  # 这就是「定期自愈」和「手动操作」能共存的原因。
  [ "$(want_get)" = "off" ] && return 0

  deck_online || return 0              # Deck 不在，修不了也不该报错
  mount_alive && return 0              # 已经是好的
  if mount_present; then
    # 陈旧挂载（Deck 睡了，挂载点还在但 stat 没响应）—— 休眠后最常见的情况。
    warn "检测到陈旧挂载，尝试强制卸载"
    clear_stale_mount || { warn "陈旧挂载清不掉，需要手动：sudo umount -f ${MOUNT_POINT}"; return 1; }
  fi
  if mount_now; then ok "已自动挂载 ${MOUNT_POINT}"; return 0; fi
  warn "自动挂载失败（Deck 可能刚醒，稍后会重试）"
  return 1
}

# toggle：用户主动切换主状态 —— files 的主状态就是「挂没挂上」。
# 菜单栏里点一下这个服务，走的就是它。挂/卸都会写「期望状态」标记。
cmd_toggle() {
  if mount_alive; then cmd_unmount; else cmd_mount; fi
}

# caps：声明本服务实现了哪些可选子命令（一行一个，命令后可跟一句说明，
# 说明会被菜单栏拿去当点击提示）。
cmd_caps() { printf 'ensure\ntoggle 挂载 / 卸载\n'; }

cmd_open() {
  # 挂载点在就打开它；不在就打开 /Volumes（让用户自己看见缺了什么）
  if [ -d "$MOUNT_POINT" ]; then open "$MOUNT_POINT"; else open /Volumes; fi
}

cmd_url() {
  printf 'NFS     nfs://%s%s\n' "$DECK_HOST" "$NFS_DIR"
  printf 'WebDAV  http://%s:%s\n' "$DECK_HOST" "$WEBDAV_PORT"
  printf '挂载点  %s\n' "$MOUNT_POINT"
}

# ------------------------------------------------------------- provision ---
cmd_provision() {
  deck_online || die "Deck 离线（${DECK_HOST}）"
  local script="$DECK_DIR/provision-root.sh"
  [ -f "$script" ] || die "找不到 $script"
  hdr "把 provision 脚本传到 Deck"
  rsh_put "$script" "$(deck_home)/deckkit/services/files/provision-root.sh" || die "传输失败"
  ok "已传输"
  hdr "在 Deck 上执行（需要免密 sudo）"
  # -t 只在交互终端加（免密 sudo 已配置时不需要 TTY，而没有终端的环境带 -t
  # 会直接失败）—— rsh_tty 自己判断。
  rsh_tty "sudo DECK_NFS_DIR=$(printf '%q' "$NFS_DIR") DECK_NFS_NET=$(printf '%q' "$CLIENT_NET") bash \"\$HOME/deckkit/services/files/provision-root.sh\" $*"
}

# ---------------------------------------------------------------- webdav ---
cmd_webdav() {
  local action="${1:-status}"
  if [ "$action" = "status" ]; then
    deck_online || die "Deck 离线"
    local st; st="$(webdav_state)"
    if [ "$st" = "active" ]; then ok "WebDAV 在跑：http://${DECK_HOST}:${WEBDAV_PORT}（共享 ${NFS_DIR}）"
    else warn "WebDAV 未运行（${st}）。启动：deck files webdav on"; fi
    return 0
  fi
  deck_online || die "Deck 离线"
  case "$action" in
    install)
      # 直接在 Deck 上重写单元是无迹可循的；以仓库里的 .service 为准。
      local unit_src="$DECK_DIR/rclone-webdav.service"
      [ -f "$unit_src" ] || die "找不到 $unit_src"
      rsh_put "$unit_src" "$(deck_home)/.config/systemd/user/${WEBDAV_UNIT}.service" || die "传输失败"
      deck_sys "daemon-reload" >/dev/null
      deck_sys "enable --now $WEBDAV_UNIT" || die "启用失败"
      sleep 1
      ok "WebDAV 已安装并启动：http://${DECK_HOST}:${WEBDAV_PORT}"
      ;;
    on)
      deck_sys "start $WEBDAV_UNIT" || die "启动失败"
      sleep 1
      ok "WebDAV 已启动：http://${DECK_HOST}:${WEBDAV_PORT}"
      ;;
    off)
      deck_sys "stop $WEBDAV_UNIT" || die "停止失败"
      ok "WebDAV 已停止"
      ;;
    *) die "webdav 只认 status / install / on / off" ;;
  esac
}

case "${1:-status}" in
  status)     shift; cmd_status "$@" ;;
  mount)      shift; cmd_mount "$@" ;;
  ensure)     shift; cmd_ensure "$@" ;;
  toggle)     shift; cmd_toggle "$@" ;;
  caps)       cmd_caps ;;
  unmount)    shift; cmd_unmount "$@" ;;
  open)       cmd_open ;;
  url)        cmd_url ;;
  provision)  shift; cmd_provision "$@" ;;
  webdav)     shift; cmd_webdav "$@" ;;
  -h|--help|help|"") sed -n '2,15p' "$0" | sed 's/^# \?//' ;;
  *) die "files 服务不认识子命令：$1" ;;
esac
